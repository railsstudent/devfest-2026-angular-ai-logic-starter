{
  "name": "devfest-2026-angular-ai-logic-starter",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "prebuild": "node firebase/scripts/prebuild.mjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "prepare": "husky",
    "cspell": "cspell --no-must-find-files --config cspell.config.mjs .",
    "cspell:collect": "cspell --words-only --unique --no-must-find-files --config cspell.config.mjs . .scratch | sort -u -o .cspell/project-words.txt .cspell/project-words.txt -",
    "check:cycles": "knip --cycles --reporter cycles",
    "lint": "ng lint && npm run check:cycles && knip --production && npm run cspell",
    "lint:fix": "eslint \"src/**/*.{ts,js,mjs}\" --fix",
    "format": "prettier --write \"**/*.{ts,js,mjs,json,html}\"",
    "firebase:emulators:start": "firebase emulators:start --project default",
    "config:fetch": "node firebase/scripts/get-firebase-remote-config.mjs",
    "config:generate": "node firebase/scripts/generate-firebase-config.mjs",
    "config:pull": "node firebase/scripts/deploy-remote-config.mjs pull",
    "config:push": "node firebase/scripts/deploy-remote-config.mjs push"
  },
  "private": true,
  "packageManager": "npm@12.2.3",
  "dependencies": {
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/router": "^22.3.0",
    "firebase": "13.4.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.5",
    "angular-eslint": "22.8.0",
    "cspell": "10.5.2",
    "eslint": "^10.15.0",
    "eslint-plugin-unicorn": "80.0.0",
    "firebase-tools": "15.37.0",
    "husky": "9.1.7",
    "jsdom": "^30.0.0",
    "knip": "6.48.0",
    "lint-staged": "17.6.2",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.74.0",
    "vitest": "^5.1.1"
  }
}
